---
import '../styles/global.css';
import SiteHeader from '../components/navigation/SiteHeader.astro';
import SiteFooter from '../components/navigation/SiteFooter.astro';

interface FaqItem {
  question: string;
  answer: string;
}

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  title?: string;
  description?: string;
  hideNavFooter?: boolean;
  faqSchema?: FaqItem[];
  breadcrumbSchema?: BreadcrumbItem[];
}

const {
  title = 'Free Resume & Biodata Builder — Unlimited, No Watermark, No Login',
  description = 'Build professional tech resumes and Indian marriage biodata for free. No login required, unlimited downloads, ATS-friendly templates, and instant template switching.',
  hideNavFooter = false,
  faqSchema,
  breadcrumbSchema,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://resume.com');
const siteTitle = 'Free Resume & Biodata Builder';
const ogImage = new URL('/favicon.svg', Astro.site || 'https://resume.com').href;

// Base WebApplication Schema
const schemaData: any = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: siteTitle,
  url: canonicalURL.href,
  description: description,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'All',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  featureList: [
    '100% Free Forever',
    'No Login or Signup Required',
    'Zero Watermarks',
    'ATS-Compliant PDF Export',
    'Microsoft Word DOCX Download',
    'FAANG Classic and Novoresume Templates',
    'Indian Marriage Biodata Formats with Kundali & Photo',
  ],
};

// FAQPage Schema for Google Rich Snippets
const faqSchemaData = faqSchema && faqSchema.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqSchema.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
} : null;

// BreadcrumbList Schema for Google Search Hierarchy
const breadcrumbSchemaData = breadcrumbSchema && breadcrumbSchema.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbSchema.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: new URL(item.url, Astro.site || 'https://resume.com').href,
  })),
} : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Pre-paint inline script to prevent theme flash (Phase 4) and protect print output -->
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('theme');
          var supportDarkMode = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (theme === 'dark' || (!theme && supportDarkMode) || (theme === 'system' && supportDarkMode)) {
            document.documentElement.classList.add('dark');
            document.documentElement.setAttribute('data-theme', 'dark');
          } else {
            document.documentElement.classList.remove('dark');
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch (e) {}

        // Guarantee 100% pure light theme rendering for PDF export & Ctrl+P printing
        var wasDarkBeforePrint = false;
        window.addEventListener('beforeprint', function () {
          if (document.documentElement.classList.contains('dark')) {
            wasDarkBeforePrint = true;
            document.documentElement.classList.remove('dark');
            document.documentElement.setAttribute('data-theme', 'light');
            document.documentElement.style.colorScheme = 'light';
          }
        });
        window.addEventListener('afterprint', function () {
          if (wasDarkBeforePrint) {
            document.documentElement.classList.add('dark');
            document.documentElement.setAttribute('data-theme', 'dark');
            document.documentElement.style.colorScheme = 'dark';
            wasDarkBeforePrint = false;
          }
        });
      })();
    </script>

    <!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:url" content={canonicalURL.href} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Schema.org JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
    {faqSchemaData && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchemaData)} />
    )}
    {breadcrumbSchemaData && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchemaData)} />
    )}

    <!-- Geist and Geist Mono font CDN -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/geist@1.3.1/dist/core.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/geist@1.3.1/dist/mono.css" />
    <!-- Traditional Biodata Classical & Devanagari Fonts + Signature Fonts + Multi-Script Indian Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Cinzel:wght@500;600;700;800&family=Dancing+Script:wght@600;700&family=Noto+Sans+Bengali:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@400;500;600;700&family=Noto+Sans+Gujarati:wght@400;500;600;700&family=Noto+Sans+Gurmukhi:wght@400;500;600;700&family=Noto+Sans+Kannada:wght@400;500;600;700&family=Noto+Sans+Malayalam:wght@400;500;600;700&family=Noto+Sans+Oriya:wght@400;500;600;700&family=Noto+Sans+Tamil:wght@400;500;600;700&family=Noto+Sans+Telugu:wght@400;500;600;700&family=Noto+Nastaliq+Urdu:wght@400;700&family=Noto+Serif+Devanagari:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-canvas text-ink antialiased flex flex-col">
    {!hideNavFooter && <SiteHeader activePath={Astro.url.pathname} />}
    <div class="flex-1">
      <slot />
    </div>
    {!hideNavFooter && <SiteFooter />}
  </body>
</html>
