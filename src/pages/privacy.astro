---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Privacy Policy — Free Resume & Biodata Builder">
  <main class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="text-3xl font-semibold tracking-tight text-ink mb-4">Privacy Policy</h1>
    <p class="text-body leading-relaxed mb-6">
      Your data belongs to you. Resumes and biodata you create remain stored locally in your browser unless you explicitly choose to export or sync. We do not sell or harvest your personal information.
    </p>
  </main>
</Layout>
