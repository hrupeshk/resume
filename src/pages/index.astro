---
import Layout from '../layouts/Layout.astro';

const homepageFaqs = [
  {
    question: 'Is this resume and biodata builder truly 100% free with no watermark?',
    answer: 'Yes, completely free forever. There are zero paywalls, no credit card requirements, no subscription traps, and zero watermarks on any exported PDF or Word (.docx) document.',
  },
  {
    question: 'Do I need to sign up or create an account to download my document?',
    answer: 'No. You can open any template, fill in your details, and download immediately with zero account creation or email verification required.',
  },
  {
    question: 'What export formats are supported?',
    answer: 'For career resumes (Tech, Non-Tech, and Private Job), you can download both selectable vector PDFs (100% ATS-compliant) and editable Microsoft Word (.docx) files. For Marriage Biodata, you can download print-ready PDFs and 2x high-resolution PNG image cards for instant WhatsApp sharing.',
  },
  {
    question: 'How is my private data stored?',
    answer: 'Your data is stored exclusively in your local web browser using HTML5 local storage. It never leaves your computer or device and is never uploaded to any remote server or third-party database.',
  },
];
---

<Layout
  title="Free Resume & Indian Marriage Biodata Builder — 100% Free, No Login"
  description="Craft high-impact ATS resumes for tech engineers, corporate leaders, and Indian private sector roles — or create beautiful traditional matrimonial biodata in minutes. Download instant print-ready PDFs and Word (.docx) without signing up."
  faqSchema={homepageFaqs}
>
  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    {/* Hero Headline */}
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-hairline bg-canvas-elevated text-xs font-mono text-mute mb-6 shadow-2xs">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>100% Free Forever</span>
        <span>•</span>
        <span>No Login Required</span>
        <span>•</span>
        <span>Zero Watermarks</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-ink mb-6 text-balance">
        Create Professional Resumes & Indian Biodata with Ease
      </h1>
      <p class="text-base sm:text-lg text-body leading-relaxed max-w-2xl mx-auto text-pretty">
        Craft high-impact ATS resumes for tech engineers, corporate leaders, and Indian private sector roles — or create beautiful traditional matrimonial biodata in minutes. Download instant print-ready PDFs and editable Word (.docx) files without signing up.
      </p>
    </div>

    {/* Option C: 2 Primary Pillars Grid */}
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-16">
      {/* Pillar 1: Professional Career Resumes */}
      <div class="p-6 sm:p-8 rounded-xl border-2 border-hairline bg-canvas-elevated shadow-sm hover:border-ink/40 transition-all flex flex-col justify-between group relative overflow-hidden">
        <div class="absolute top-0 right-0 transform translate-x-4 -translate-y-4 w-32 h-32 bg-primary/5 rounded-full blur-2xl pointer-events-none"></div>

        <div>
          <div class="flex items-center justify-between mb-5">
            <div class="flex items-center gap-2.5">
              <span class="text-2xl" aria-hidden="true">📄</span>
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-primary">Pillar 01</span>
            </div>
            <span class="text-[11px] font-mono font-semibold uppercase px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200">
              ATS-Optimized
            </span>
          </div>

          <h2 class="text-2xl font-bold text-ink tracking-tight mb-3 group-hover:text-black">
            Professional Job Resumes & CVs
          </h2>
          <p class="text-sm text-body leading-relaxed mb-6">
            Industry-tailored CV formats engineered for recruiter review. Whether applying to Silicon Valley startups, corporate multinationals, or Indian private enterprises, get certified formats that pass screening.
          </p>

          {/* Quick-Start Role Tags with Direct Builder Links */}
          <div class="space-y-2.5 mb-8">
            <div class="text-[11px] font-mono uppercase tracking-wider text-mute font-semibold">
              Select Your Career Domain:
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
              <a
                href="/build/private_job_resume"
                class="p-2.5 rounded-md border border-hairline bg-canvas hover:bg-neutral-100 hover:border-ink/30 transition-all text-left flex flex-col justify-between group/tag"
              >
                <div class="text-xs font-semibold text-ink group-hover/tag:text-primary mb-1">
                  🏢 Private Job CV
                </div>
                <div class="text-[10px] text-mute leading-tight">
                  With Photo, Father's Name & Declaration
                </div>
              </a>

              <a
                href="/build/tech_resume"
                class="p-2.5 rounded-md border border-hairline bg-canvas hover:bg-neutral-100 hover:border-ink/30 transition-all text-left flex flex-col justify-between group/tag"
              >
                <div class="text-xs font-semibold text-ink group-hover/tag:text-primary mb-1">
                  💻 Tech & IT Resume
                </div>
                <div class="text-[10px] text-mute leading-tight">
                  Jake's FAANG & 2-Col Developer
                </div>
              </a>

              <a
                href="/build/non_tech_resume"
                class="p-2.5 rounded-md border border-hairline bg-canvas hover:bg-neutral-100 hover:border-ink/30 transition-all text-left flex flex-col justify-between group/tag"
              >
                <div class="text-xs font-semibold text-ink group-hover/tag:text-primary mb-1">
                  👔 Corporate & MBA
                </div>
                <div class="text-[10px] text-mute leading-tight">
                  Executive Harvard & Competencies
                </div>
              </a>
            </div>
          </div>
        </div>

        <div class="pt-4 border-t border-hairline flex flex-col sm:flex-row items-center justify-between gap-3">
          <div class="text-xs text-mute flex items-center gap-2">
            <span>✓ ATS Parsable</span>
            <span>•</span>
            <span>✓ Word DOCX & PDF</span>
            <span>•</span>
            <span>✓ Auto-Save</span>
          </div>
          <div class="flex items-center gap-2 w-full sm:w-auto">
            <a
              href="/tech-resume"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-sm border border-hairline bg-canvas hover:bg-neutral-100 text-ink text-xs font-medium transition-colors"
            >
              <span>Explore Formats</span>
            </a>
            <a
              href="/build/tech_resume"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2 rounded-sm bg-primary text-on-primary text-xs font-semibold hover:opacity-90 transition-opacity shadow-xs"
            >
              <span>Build Resume</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>

      {/* Pillar 2: Indian Marriage Biodata */}
      <div class="p-6 sm:p-8 rounded-xl border-2 border-hairline bg-canvas-elevated shadow-sm hover:border-ink/40 transition-all flex flex-col justify-between group relative overflow-hidden">
        <div class="absolute top-0 right-0 transform translate-x-4 -translate-y-4 w-32 h-32 bg-rose-500/5 rounded-full blur-2xl pointer-events-none"></div>

        <div>
          <div class="flex items-center justify-between mb-5">
            <div class="flex items-center gap-2.5">
              <span class="text-2xl" aria-hidden="true">🪔</span>
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-rose-800">Pillar 02</span>
            </div>
            <span class="text-[11px] font-mono font-semibold uppercase px-2.5 py-0.5 rounded-full bg-rose-50 text-rose-900 border border-rose-200">
              Cultural & Matrimonial
            </span>
          </div>

          <h2 class="text-2xl font-bold text-ink tracking-tight mb-3 group-hover:text-black">
            Indian Marriage Biodata
          </h2>
          <p class="text-sm text-body leading-relaxed mb-6">
            Dignified matrimonial biodata profiles created specifically for Indian families and marriage alliances. Elegant aesthetics honoring cultural traditions with modern typographic poise.
          </p>

          {/* Cultural Highlights */}
          <div class="space-y-2.5 mb-8">
            <div class="text-[11px] font-mono uppercase tracking-wider text-mute font-semibold">
              Included Matrimonial Sections:
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
              <div class="p-2.5 rounded-md border border-hairline bg-canvas text-left">
                <div class="text-xs font-semibold text-ink mb-1">
                  🕉️ Sacred Invocations
                </div>
                <div class="text-[10px] text-mute leading-tight">
                  Ganesh, Radha Krishna, Swastik
                </div>
              </div>

              <div class="p-2.5 rounded-md border border-hairline bg-canvas text-left">
                <div class="text-xs font-semibold text-ink mb-1">
                  ⭐ Horoscope & Kundali
                </div>
                <div class="text-[10px] text-mute leading-tight">
                  Rashi, Nakshatra, Gotra & Manglik
                </div>
              </div>

              <div class="p-2.5 rounded-md border border-hairline bg-canvas text-left">
                <div class="text-xs font-semibold text-ink mb-1">
                  👨‍👩‍👧 Family Particulars
                </div>
                <div class="text-[10px] text-mute leading-tight">
                  Parents, Siblings & Native Place
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="pt-4 border-t border-hairline flex flex-col sm:flex-row items-center justify-between gap-3">
          <div class="text-xs text-mute flex items-center gap-2">
            <span>✓ Traditional Maroon</span>
            <span>•</span>
            <span>✓ Photo Frame</span>
            <span>•</span>
            <span>✓ WhatsApp Card</span>
          </div>
          <div class="flex items-center gap-2 w-full sm:w-auto">
            <a
              href="/marriage-biodata"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-sm border border-hairline bg-canvas hover:bg-neutral-100 text-ink text-xs font-medium transition-colors"
            >
              <span>Explore Formats</span>
            </a>
            <a
              href="/build/marriage_biodata"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2 rounded-sm bg-[#800020] text-white text-xs font-semibold hover:bg-[#66001a] transition-colors shadow-xs"
            >
              <span>Build Biodata</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    {/* Feature Highlights Grid */}
    <div class="rounded-xl border border-hairline bg-canvas p-6 sm:p-8 mb-16">
      <div class="text-center max-w-xl mx-auto mb-8">
        <h3 class="text-lg font-semibold text-ink mb-2">
          Everything You Need to Succeed
        </h3>
        <p class="text-xs sm:text-sm text-body">
          Built for real job seekers and families with no artificial paywalls or hidden subscriptions.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="space-y-1.5">
          <div class="text-base font-semibold text-ink">⚡ Live Synchronous Preview</div>
          <p class="text-xs text-mute leading-relaxed">
            See your changes render in real-time as you type, with accurate page break indicators and 1-page auto-fit.
          </p>
        </div>

        <div class="space-y-1.5">
          <div class="text-base font-semibold text-ink">📝 Word (.docx) & Vector PDF</div>
          <p class="text-xs text-mute leading-relaxed">
            Download editable Microsoft Word documents or high-precision vector PDFs with selectable text.
          </p>
        </div>

        <div class="space-y-1.5">
          <div class="text-base font-semibold text-ink">🔒 100% Private in Browser</div>
          <p class="text-xs text-mute leading-relaxed">
            Your data is saved locally in your browser storage. Zero tracking, no server uploads, and no data selling.
          </p>
        </div>

        <div class="space-y-1.5">
          <div class="text-base font-semibold text-ink">🎨 Instant Template Switching</div>
          <p class="text-xs text-mute leading-relaxed">
            Switch between modern and classic templates instantly with our zero data loss guarantee.
          </p>
        </div>
      </div>
    </div>

    {/* Section: Frequently Asked Questions (FAQ) with FAQPage Schema */}
    <div class="mb-12">
      <div class="text-center max-w-xl mx-auto mb-10">
        <span class="text-xs font-mono uppercase tracking-wider text-primary font-bold">Frequently Asked</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-ink mt-1 mb-2">
          Common Questions & Answers
        </h2>
        <p class="text-xs sm:text-sm text-body">
          Clear, transparent answers about our free document builder.
        </p>
      </div>

      <div class="max-w-3xl mx-auto space-y-4">
        {homepageFaqs.map((faq) => (
          <div class="p-5 rounded-lg border border-hairline bg-canvas-elevated shadow-2xs">
            <h3 class="text-sm sm:text-base font-bold text-ink mb-2">
              {faq.question}
            </h3>
            <p class="text-xs sm:text-sm text-body leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </div>
  </main>
</Layout>
