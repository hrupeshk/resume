---
interface Props {
  activePath?: string;
}

const { activePath = '' } = Astro.props;

const navLinks = [
  { href: '/tech-resume', label: 'Tech & IT Resumes', badge: 'ATS Gold' },
  { href: '/private-job-cv', label: 'Private Job CV', badge: 'Popular' },
  { href: '/marriage-biodata', label: 'Marriage Biodata', badge: 'Traditional' },
  { href: '/non-tech-resume', label: 'Corporate & MBA' },
];
---

<header class="sticky top-0 z-40 w-full border-b border-hairline bg-canvas/80 backdrop-blur-md transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    {/* Brand Logo */}
    <a href="/" class="flex items-center gap-2.5 group cursor-pointer" aria-label="Resume & Biodata Builder Home">
      <div class="w-8 h-8 rounded-md bg-neutral-900 text-white flex items-center justify-center font-bold text-base shadow-xs group-hover:bg-neutral-800 transition-colors">
        <span>R</span>
      </div>
      <div class="flex flex-col">
        <span class="text-sm font-bold tracking-tight text-ink group-hover:text-primary transition-colors">
          Resume<span class="text-blue-600">.com</span>
        </span>
        <span class="text-[10px] font-mono text-mute -mt-0.5 tracking-tight">
          100% Free • No Login
        </span>
      </div>
    </a>

    {/* Desktop Navigation Links */}
    <nav class="hidden md:flex items-center gap-1 lg:gap-2" aria-label="Main Navigation">
      {navLinks.map((link) => {
        const isActive = activePath === link.href || activePath.startsWith(link.href);
        return (
          <a
            href={link.href}
            class={`px-3 py-1.5 rounded-sm text-xs font-medium transition-colors flex items-center gap-1.5 ${
              isActive
                ? 'bg-neutral-100 text-ink font-semibold'
                : 'text-body hover:text-ink hover:bg-neutral-100/60'
            }`}
          >
            <span>{link.label}</span>
            {link.badge && (
              <span class={`text-[9px] px-1.5 py-0.2 rounded-xs font-mono uppercase tracking-wider ${
                link.badge === 'ATS Gold'
                  ? 'bg-emerald-50 text-emerald-800 border border-emerald-200'
                  : link.badge === 'Traditional'
                  ? 'bg-rose-50 text-rose-800 border border-rose-200'
                  : 'bg-neutral-100 text-neutral-600'
              }`}>
                {link.badge}
              </span>
            )}
          </a>
        );
      })}
    </nav>

    {/* Direct Action CTA */}
    <div class="flex items-center gap-3">
      <div class="hidden sm:inline-flex items-center gap-1.5 text-[11px] font-mono text-mute px-2 py-1 rounded-sm bg-neutral-100/60 border border-hairline">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Zero Watermarks</span>
      </div>

      <a
        href="/build/tech_resume"
        class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-sm bg-primary text-on-primary text-xs font-semibold hover:opacity-90 transition-opacity shadow-xs cursor-pointer"
      >
        <span>Build Resume Now</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</header>
