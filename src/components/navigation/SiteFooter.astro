---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-hairline bg-canvas mt-16 sm:mt-24 text-body">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-10 mb-12">
      {/* Brand Column */}
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-2.5" aria-label="Home">
          <div class="w-7 h-7 rounded-md bg-neutral-900 text-white flex items-center justify-center font-bold text-sm shadow-xs">
            <span>R</span>
          </div>
          <span class="text-sm font-bold tracking-tight text-ink">
            Resume<span class="text-blue-600">.com</span>
          </span>
        </a>
        <p class="text-xs text-mute max-w-sm leading-relaxed">
          The genuinely free, open document builder. Engineered for job seekers, software engineers, and families. No forced signups, no credit cards, zero watermarks, and unlimited PDF & DOCX downloads forever.
        </p>
        <div class="flex items-center gap-2 pt-1 text-[11px] font-mono text-mute">
          <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-xs bg-emerald-50 text-emerald-800 border border-emerald-200">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            100% In-Browser Privacy
          </span>
          <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-xs bg-neutral-100 text-neutral-700 border border-neutral-200">
            ATS-Certified
          </span>
        </div>
      </div>

      {/* Column 2: Resume Categories */}
      <div class="space-y-3">
        <div class="text-xs font-mono font-bold uppercase tracking-wider text-ink">
          Templates & Formats
        </div>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/tech-resume" class="hover:text-ink transition-colors flex items-center gap-1.5">
              <span>Tech & IT Resumes</span>
              <span class="text-[9px] px-1 bg-emerald-100 text-emerald-800 rounded font-mono">Jake's</span>
            </a>
          </li>
          <li>
            <a href="/private-job-cv" class="hover:text-ink transition-colors">
              Private Job CV (With Photo)
            </a>
          </li>
          <li>
            <a href="/marriage-biodata" class="hover:text-ink transition-colors flex items-center gap-1.5">
              <span>Marriage Biodata</span>
              <span class="text-[9px] px-1 bg-rose-100 text-rose-800 rounded font-mono">Vedic</span>
            </a>
          </li>
          <li>
            <a href="/non-tech-resume" class="hover:text-ink transition-colors">
              Corporate & MBA Resume
            </a>
          </li>
        </ul>
      </div>

      {/* Column 3: Free Export Features */}
      <div class="space-y-3">
        <div class="text-xs font-mono font-bold uppercase tracking-wider text-ink">
          Export Capabilities
        </div>
        <ul class="space-y-2 text-xs text-mute">
          <li class="flex items-center gap-1.5">
            <span class="text-emerald-600">✓</span>
            <span>Vector PDF (Selectable text)</span>
          </li>
          <li class="flex items-center gap-1.5">
            <span class="text-emerald-600">✓</span>
            <span>Microsoft Word (.docx)</span>
          </li>
          <li class="flex items-center gap-1.5">
            <span class="text-emerald-600">✓</span>
            <span>WhatsApp 2x Image Card (PNG)</span>
          </li>
          <li class="flex items-center gap-1.5">
            <span class="text-emerald-600">✓</span>
            <span>JSON Backup & Offline Restore</span>
          </li>
          <li class="flex items-center gap-1.5">
            <span class="text-emerald-600">✓</span>
            <span>A4 Single-Page Perfect Fit</span>
          </li>
        </ul>
      </div>

      {/* Column 4: Platform & Trust */}
      <div class="space-y-3">
        <div class="text-xs font-mono font-bold uppercase tracking-wider text-ink">
          Transparency & Trust
        </div>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/about" class="hover:text-ink transition-colors">
              About Our Mission
            </a>
          </li>
          <li>
            <a href="/privacy" class="hover:text-ink transition-colors">
              Privacy Policy (No Data Selling)
            </a>
          </li>
          <li>
            <a href="/contact" class="hover:text-ink transition-colors">
              Contact & Support
            </a>
          </li>
          <li>
            <a href="/sitemap.xml" class="hover:text-ink transition-colors font-mono text-[11px]">
              Sitemap.xml
            </a>
          </li>
        </ul>
      </div>
    </div>

    {/* Bottom Copyright and Legal Bar */}
    <div class="pt-8 border-t border-hairline flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-mute">
      <div>
        © {currentYear} Resume.com. Built with privacy-first client-side architecture.
      </div>
      <div class="flex items-center gap-4 text-[11px] font-mono">
        <span>No Trackers</span>
        <span>•</span>
        <span>No Cookies Required</span>
        <span>•</span>
        <span>100% Free Forever</span>
      </div>
    </div>
  </div>
</footer>
